(program
  (protocol DecimalOps
    (query Lit_d2 () (Decimal 2))
    (query Add_d2 ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Sub_d2 ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Add_d0 ((a (Decimal 0)) (b (Decimal 0))) (Decimal 0))
    (query Mul_d2_d3 ((a (Decimal 2)) (b (Decimal 3))) (Decimal 5))
    (query Mul_d20_d17 ((a (Decimal 20)) (b (Decimal 17))) (Decimal 37))
    (query Eq_d2 ((a (Decimal 2)) (b (Decimal 2))) Bool)
    (query Lt_d2 ((a (Decimal 2)) (b (Decimal 2))) Bool)
    (query Round_up ((a (Decimal 3))) (Decimal 1))
    (query RoundInt_up ((a (Decimal 2))) Int)
    (query Div_up ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Round_down ((a (Decimal 3))) (Decimal 1))
    (query RoundInt_down ((a (Decimal 2))) Int)
    (query Div_down ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Round_ceiling ((a (Decimal 3))) (Decimal 1))
    (query RoundInt_ceiling ((a (Decimal 2))) Int)
    (query Div_ceiling ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Round_floor ((a (Decimal 3))) (Decimal 1))
    (query RoundInt_floor ((a (Decimal 2))) Int)
    (query Div_floor ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Round_half_up ((a (Decimal 3))) (Decimal 1))
    (query RoundInt_half_up ((a (Decimal 2))) Int)
    (query Div_half_up ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Round_half_down ((a (Decimal 3))) (Decimal 1))
    (query RoundInt_half_down ((a (Decimal 2))) Int)
    (query Div_half_down ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Round_half_even ((a (Decimal 3))) (Decimal 1))
    (query RoundInt_half_even ((a (Decimal 2))) Int)
    (query Div_half_even ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Round_exact ((a (Decimal 3))) (Decimal 1))
    (query RoundInt_exact ((a (Decimal 2))) Int)
    (query Div_exact ((a (Decimal 2)) (b (Decimal 2))) (Decimal 2))
    (query Widen ((a (Decimal 1))) (Decimal 3))
    (query FromInt ((n Int)) (Decimal 2))
    (query ToInt ((a (Decimal 0))) Int))
  (machine DecimalCalc (key Int) (protocol DecimalOps) (uses) (init Ready)
    (state Ready)
    (in Ready
      (on Lit_d2 (block (answer (dec 12.50))))
      (on Add_d2 (block (answer (+ a b))))
      (on Sub_d2 (block (answer (- a b))))
      (on Add_d0 (block (answer (+ a b))))
      (on Mul_d2_d3 (block (answer (* a b))))
      (on Mul_d20_d17 (block (answer (* a b))))
      (on Eq_d2 (block (answer (== a b))))
      (on Lt_d2 (block (answer (< a b))))
      (on Round_up (block (answer (round (Decimal 1) up a))))
      (on RoundInt_up (block (answer (round Int up a))))
      (on Div_up (block (answer (div (Decimal 2) up a b))))
      (on Round_down (block (answer (round (Decimal 1) down a))))
      (on RoundInt_down (block (answer (round Int down a))))
      (on Div_down (block (answer (div (Decimal 2) down a b))))
      (on Round_ceiling (block (answer (round (Decimal 1) ceiling a))))
      (on RoundInt_ceiling (block (answer (round Int ceiling a))))
      (on Div_ceiling (block (answer (div (Decimal 2) ceiling a b))))
      (on Round_floor (block (answer (round (Decimal 1) floor a))))
      (on RoundInt_floor (block (answer (round Int floor a))))
      (on Div_floor (block (answer (div (Decimal 2) floor a b))))
      (on Round_half_up (block (answer (round (Decimal 1) half_up a))))
      (on RoundInt_half_up (block (answer (round Int half_up a))))
      (on Div_half_up (block (answer (div (Decimal 2) half_up a b))))
      (on Round_half_down (block (answer (round (Decimal 1) half_down a))))
      (on RoundInt_half_down (block (answer (round Int half_down a))))
      (on Div_half_down (block (answer (div (Decimal 2) half_down a b))))
      (on Round_half_even (block (answer (round (Decimal 1) half_even a))))
      (on RoundInt_half_even (block (answer (round Int half_even a))))
      (on Div_half_even (block (answer (div (Decimal 2) half_even a b))))
      (on Round_exact (block (answer (round (Decimal 1) exact a))))
      (on RoundInt_exact (block (answer (round Int exact a))))
      (on Div_exact (block (answer (div (Decimal 2) exact a b))))
      (on Widen (block (answer (round (Decimal 3) exact a))))
      (on FromInt (block (answer (round (Decimal 2) exact n))))
      (on ToInt (block (answer (round Int exact a))))))
  (protocol TillOps
    (command Put ((v (Decimal 2))) Unit (rejects)))
  (machine Till (key Int) (protocol TillOps) (uses) (init Empty)
    (state Empty)
    (state Holding (v (Decimal 2)))
    (group Any Empty Holding)
    (in Any
      (on Put (block (next (Holding v) (outcome (unit)))))))
  (example lit_d2 (machine DecimalCalc) (key 1)
    (actor u)
    (send u Lit_d2 (expect (answer (dec 12.50)))))
  (example add_d2 (machine DecimalCalc) (key 1)
    (actor u)
    (send u Add_d2 (dec 1.25) (dec 2.50) (expect (answer (dec 3.75))))
    (send u Add_d2 (dec 0.05) (dec 0.05) (expect (answer (dec 0.10))))
    (send u Add_d2 (dec -1.25) (dec 1.25) (expect (answer (dec 0.00))))
    (send u Add_d2 (dec -0.05) (dec 0.00) (expect (answer (dec -0.05))))
    (send u Add_d2 (dec 0.00) (dec 0.00) (expect (answer (dec 0.00))))
    (send u Add_d2 (dec -1.25) (dec -2.50) (expect (answer (dec -3.75))))
    (send u Add_d2 (dec 999999999999999999999999999999999999.99) (dec 0.00) (expect (answer (dec 999999999999999999999999999999999999.99))))
    (send u Add_d2 (dec 999999999999999999999999999999999999.99) (dec 0.01) (expect (fault overflow)))
    (send u Add_d2 (dec -999999999999999999999999999999999999.99) (dec -0.01) (expect (fault overflow)))
    (send u Add_d2 (dec 999999999999999999999999999999999999.99) (dec -999999999999999999999999999999999999.99) (expect (answer (dec 0.00)))))
  (example sub_d2 (machine DecimalCalc) (key 1)
    (actor u)
    (send u Sub_d2 (dec 3.75) (dec 1.25) (expect (answer (dec 2.50))))
    (send u Sub_d2 (dec 1.25) (dec 3.75) (expect (answer (dec -2.50))))
    (send u Sub_d2 (dec 0.10) (dec 0.05) (expect (answer (dec 0.05))))
    (send u Sub_d2 (dec 0.00) (dec 0.05) (expect (answer (dec -0.05))))
    (send u Sub_d2 (dec -0.05) (dec -0.05) (expect (answer (dec 0.00))))
    (send u Sub_d2 (dec 999999999999999999999999999999999999.99) (dec 0.00) (expect (answer (dec 999999999999999999999999999999999999.99))))
    (send u Sub_d2 (dec 999999999999999999999999999999999999.99) (dec -0.01) (expect (fault overflow)))
    (send u Sub_d2 (dec -999999999999999999999999999999999999.99) (dec 0.01) (expect (fault overflow)))
    (send u Sub_d2 (dec -999999999999999999999999999999999999.99) (dec 0.00) (expect (answer (dec -999999999999999999999999999999999999.99))))
    (send u Sub_d2 (dec 999999999999999999999999999999999999.99) (dec 999999999999999999999999999999999999.99) (expect (answer (dec 0.00)))))
  (example add_d0 (machine DecimalCalc) (key 1)
    (actor u)
    (send u Add_d0 (dec 7) (dec 5) (expect (answer (dec 12))))
    (send u Add_d0 (dec -7) (dec 0) (expect (answer (dec -7))))
    (send u Add_d0 (dec 0) (dec 0) (expect (answer (dec 0))))
    (send u Add_d0 (dec -7) (dec 7) (expect (answer (dec 0))))
    (send u Add_d0 (dec 99999999999999999999999999999999999999) (dec 0) (expect (answer (dec 99999999999999999999999999999999999999))))
    (send u Add_d0 (dec 99999999999999999999999999999999999999) (dec 1) (expect (fault overflow)))
    (send u Add_d0 (dec -99999999999999999999999999999999999999) (dec -1) (expect (fault overflow)))
    (send u Add_d0 (dec 99999999999999999999999999999999999999) (dec -1) (expect (answer (dec 99999999999999999999999999999999999998))))
    (send u Add_d0 (dec -99999999999999999999999999999999999999) (dec 99999999999999999999999999999999999999) (expect (answer (dec 0)))))
  (example mul_d2_d3 (machine DecimalCalc) (key 1)
    (actor u)
    (send u Mul_d2_d3 (dec 1.25) (dec 2.000) (expect (answer (dec 2.50000))))
    (send u Mul_d2_d3 (dec 0.01) (dec 0.001) (expect (answer (dec 0.00001))))
    (send u Mul_d2_d3 (dec -1.50) (dec 2.500) (expect (answer (dec -3.75000))))
    (send u Mul_d2_d3 (dec -1.50) (dec -2.500) (expect (answer (dec 3.75000))))
    (send u Mul_d2_d3 (dec 0.00) (dec -1.000) (expect (answer (dec 0.00000))))
    (send u Mul_d2_d3 (dec 12.34) (dec 1000.000) (expect (answer (dec 12340.00000))))
    (send u Mul_d2_d3 (dec 999999999999999999999999999999999999.99) (dec 0.001) (expect (answer (dec 999999999999999999999999999999999.99999))))
    (send u Mul_d2_d3 (dec 999999999999999999999999999999999999.99) (dec 0.002) (expect (fault overflow)))
    (send u Mul_d2_d3 (dec -999999999999999999999999999999999999.99) (dec 0.001) (expect (answer (dec -999999999999999999999999999999999.99999))))
    (send u Mul_d2_d3 (dec -999999999999999999999999999999999999.99) (dec 0.002) (expect (fault overflow))))
  (example mul_d20_d17 (machine DecimalCalc) (key 1)
    (actor u)
    (send u Mul_d20_d17 (dec 0.00000000000000000001) (dec 0.00000000000000001) (expect (answer (dec 0.0000000000000000000000000000000000001))))
    (send u Mul_d20_d17 (dec 1.00000000000000000000) (dec 1.00000000000000000) (expect (answer (dec 1.0000000000000000000000000000000000000))))
    (send u Mul_d20_d17 (dec 9.99999999999999999999) (dec 0.99999999999999999) (expect (answer (dec 9.9999999999999998999900000000000000001))))
    (send u Mul_d20_d17 (dec -9.99999999999999999999) (dec -0.99999999999999999) (expect (answer (dec 9.9999999999999998999900000000000000001))))
    (send u Mul_d20_d17 (dec 10.00000000000000000000) (dec 1.00000000000000000) (expect (fault overflow)))
    (send u Mul_d20_d17 (dec -10.00000000000000000000) (dec 1.00000000000000000) (expect (fault overflow)))
    (send u Mul_d20_d17 (dec -0.50000000000000000000) (dec 0.20000000000000000) (expect (answer (dec -0.1000000000000000000000000000000000000))))
    (send u Mul_d20_d17 (dec 0.00000000000000000000) (dec -1.00000000000000000) (expect (answer (dec 0.0000000000000000000000000000000000000))))
    (send u Mul_d20_d17 (dec 999999999999999999.99999999999999999999) (dec 0.00000000000000001) (expect (answer (dec 9.9999999999999999999999999999999999999))))
    (send u Mul_d20_d17 (dec 999999999999999999.99999999999999999999) (dec 0.00000000000000002) (expect (fault overflow))))
  (example eq_d2 (machine DecimalCalc) (key 1)
    (actor u)
    (send u Eq_d2 (dec 1.25) (dec 1.25) (expect (answer true)))
    (send u Eq_d2 (dec 1.25) (dec 1.26) (expect (answer false)))
    (send u Eq_d2 (dec -0.05) (dec 0.05) (expect (answer false)))
    (send u Eq_d2 (dec 0.00) (dec 0.00) (expect (answer true)))
    (send u Eq_d2 (dec 0.10) (dec 0.01) (expect (answer false)))
    (send u Eq_d2 (dec 999999999999999999999999999999999999.99) (dec 999999999999999999999999999999999999.99) (expect (answer true)))
    (send u Eq_d2 (dec -999999999999999999999999999999999999.99) (dec 999999999999999999999999999999999999.99) (expect (answer false))))
  (example lt_d2 (machine DecimalCalc) (key 1)
    (actor u)
    (send u Lt_d2 (dec 1.25) (dec 1.26) (expect (answer true)))
    (send u Lt_d2 (dec 1.26) (dec 1.25) (expect (answer false)))
    (send u Lt_d2 (dec 1.25) (dec 1.25) (expect (answer false)))
    (send u Lt_d2 (dec -1.25) (dec 1.25) (expect (answer true)))
    (send u Lt_d2 (dec 1.25) (dec -1.25) (expect (answer false)))
    (send u Lt_d2 (dec 0.10) (dec 0.01) (expect (answer false)))
    (send u Lt_d2 (dec -0.10) (dec -0.01) (expect (answer true)))
    (send u Lt_d2 (dec 0.00) (dec 0.01) (expect (answer true)))
    (send u Lt_d2 (dec -0.01) (dec 0.00) (expect (answer true)))
    (send u Lt_d2 (dec -999999999999999999999999999999999999.99) (dec 999999999999999999999999999999999999.99) (expect (answer true)))
    (send u Lt_d2 (dec 999999999999999999999999999999999999.99) (dec -999999999999999999999999999999999999.99) (expect (answer false))))
  (example round_up (machine DecimalCalc) (key 1)
    (actor u)
    (send u Round_up (dec 1.250) (expect (answer (dec 1.3))))
    (send u Round_up (dec 1.350) (expect (answer (dec 1.4))))
    (send u Round_up (dec -1.250) (expect (answer (dec -1.3))))
    (send u Round_up (dec -1.350) (expect (answer (dec -1.4))))
    (send u Round_up (dec 1.251) (expect (answer (dec 1.3))))
    (send u Round_up (dec -1.251) (expect (answer (dec -1.3))))
    (send u Round_up (dec 1.249) (expect (answer (dec 1.3))))
    (send u Round_up (dec -1.249) (expect (answer (dec -1.3))))
    (send u Round_up (dec 1.200) (expect (answer (dec 1.2))))
    (send u Round_up (dec -1.200) (expect (answer (dec -1.2))))
    (send u Round_up (dec 0.000) (expect (answer (dec 0.0))))
    (send u Round_up (dec 0.050) (expect (answer (dec 0.1))))
    (send u Round_up (dec -0.050) (expect (answer (dec -0.1))))
    (send u Round_up (dec 0.049) (expect (answer (dec 0.1))))
    (send u Round_up (dec -0.049) (expect (answer (dec -0.1))))
    (send u Round_up (dec 99999999999999999999999999999999999.999) (expect (answer (dec 100000000000000000000000000000000000.0))))
    (send u Round_up (dec -99999999999999999999999999999999999.999) (expect (answer (dec -100000000000000000000000000000000000.0)))))
  (example roundint_up (machine DecimalCalc) (key 1)
    (actor u)
    (send u RoundInt_up (dec 2.50) (expect (answer 3)))
    (send u RoundInt_up (dec 3.50) (expect (answer 4)))
    (send u RoundInt_up (dec -2.50) (expect (answer -3)))
    (send u RoundInt_up (dec -3.50) (expect (answer -4)))
    (send u RoundInt_up (dec 2.51) (expect (answer 3)))
    (send u RoundInt_up (dec -2.51) (expect (answer -3)))
    (send u RoundInt_up (dec 2.49) (expect (answer 3)))
    (send u RoundInt_up (dec -2.49) (expect (answer -3)))
    (send u RoundInt_up (dec 2.00) (expect (answer 2)))
    (send u RoundInt_up (dec -2.00) (expect (answer -2)))
    (send u RoundInt_up (dec 0.00) (expect (answer 0)))
    (send u RoundInt_up (dec 0.50) (expect (answer 1)))
    (send u RoundInt_up (dec -0.50) (expect (answer -1)))
    (send u RoundInt_up (dec 0.49) (expect (answer 1)))
    (send u RoundInt_up (dec -0.49) (expect (answer -1)))
    (send u RoundInt_up (dec 9223372036854775807.00) (expect (answer 9223372036854775807)))
    (send u RoundInt_up (dec 9223372036854775807.50) (expect (fault overflow)))
    (send u RoundInt_up (dec 9223372036854775808.00) (expect (fault overflow)))
    (send u RoundInt_up (dec -9223372036854775808.00) (expect (answer -9223372036854775808)))
    (send u RoundInt_up (dec -9223372036854775808.50) (expect (fault overflow)))
    (send u RoundInt_up (dec -9223372036854775809.00) (expect (fault overflow)))
    (send u RoundInt_up (dec 999999999999999999999999999999999999.99) (expect (fault overflow)))
    (send u RoundInt_up (dec -999999999999999999999999999999999999.99) (expect (fault overflow))))
  (example div_up (machine DecimalCalc) (key 1)
    (actor u)
    (send u Div_up (dec 7.50) (dec 2.50) (expect (answer (dec 3.00))))
    (send u Div_up (dec 1.00) (dec 8.00) (expect (answer (dec 0.13))))
    (send u Div_up (dec 3.00) (dec 8.00) (expect (answer (dec 0.38))))
    (send u Div_up (dec -1.00) (dec 8.00) (expect (answer (dec -0.13))))
    (send u Div_up (dec 1.00) (dec -8.00) (expect (answer (dec -0.13))))
    (send u Div_up (dec -3.00) (dec -8.00) (expect (answer (dec 0.38))))
    (send u Div_up (dec 1.00) (dec 3.00) (expect (answer (dec 0.34))))
    (send u Div_up (dec 2.00) (dec 3.00) (expect (answer (dec 0.67))))
    (send u Div_up (dec -1.00) (dec 3.00) (expect (answer (dec -0.34))))
    (send u Div_up (dec 2.00) (dec -3.00) (expect (answer (dec -0.67))))
    (send u Div_up (dec 0.01) (dec 3.00) (expect (answer (dec 0.01))))
    (send u Div_up (dec -0.01) (dec 3.00) (expect (answer (dec -0.01))))
    (send u Div_up (dec 0.00) (dec 5.00) (expect (answer (dec 0.00))))
    (send u Div_up (dec 1.00) (dec 0.00) (expect (fault div_zero)))
    (send u Div_up (dec 0.00) (dec 0.00) (expect (fault div_zero)))
    (send u Div_up (dec 999999999999999999999999999999999999.99) (dec 1.00) (expect (answer (dec 999999999999999999999999999999999999.99))))
    (send u Div_up (dec 999999999999999999999999999999999999.99) (dec 0.01) (expect (fault overflow)))
    (send u Div_up (dec 999999999999999999999999999999999999.99) (dec 0.07) (expect (fault overflow)))
    (send u Div_up (dec -999999999999999999999999999999999999.99) (dec 0.07) (expect (fault overflow)))
    (send u Div_up (dec 0.01) (dec 999999999999999999999999999999999999.99) (expect (answer (dec 0.01))))
    (send u Div_up (dec -0.01) (dec 999999999999999999999999999999999999.99) (expect (answer (dec -0.01)))))
  (example round_down (machine DecimalCalc) (key 1)
    (actor u)
    (send u Round_down (dec 1.250) (expect (answer (dec 1.2))))
    (send u Round_down (dec 1.350) (expect (answer (dec 1.3))))
    (send u Round_down (dec -1.250) (expect (answer (dec -1.2))))
    (send u Round_down (dec -1.350) (expect (answer (dec -1.3))))
    (send u Round_down (dec 1.251) (expect (answer (dec 1.2))))
    (send u Round_down (dec -1.251) (expect (answer (dec -1.2))))
    (send u Round_down (dec 1.249) (expect (answer (dec 1.2))))
    (send u Round_down (dec -1.249) (expect (answer (dec -1.2))))
    (send u Round_down (dec 1.200) (expect (answer (dec 1.2))))
    (send u Round_down (dec -1.200) (expect (answer (dec -1.2))))
    (send u Round_down (dec 0.000) (expect (answer (dec 0.0))))
    (send u Round_down (dec 0.050) (expect (answer (dec 0.0))))
    (send u Round_down (dec -0.050) (expect (answer (dec 0.0))))
    (send u Round_down (dec 0.049) (expect (answer (dec 0.0))))
    (send u Round_down (dec -0.049) (expect (answer (dec 0.0))))
    (send u Round_down (dec 99999999999999999999999999999999999.999) (expect (answer (dec 99999999999999999999999999999999999.9))))
    (send u Round_down (dec -99999999999999999999999999999999999.999) (expect (answer (dec -99999999999999999999999999999999999.9)))))
  (example roundint_down (machine DecimalCalc) (key 1)
    (actor u)
    (send u RoundInt_down (dec 2.50) (expect (answer 2)))
    (send u RoundInt_down (dec 3.50) (expect (answer 3)))
    (send u RoundInt_down (dec -2.50) (expect (answer -2)))
    (send u RoundInt_down (dec -3.50) (expect (answer -3)))
    (send u RoundInt_down (dec 2.51) (expect (answer 2)))
    (send u RoundInt_down (dec -2.51) (expect (answer -2)))
    (send u RoundInt_down (dec 2.49) (expect (answer 2)))
    (send u RoundInt_down (dec -2.49) (expect (answer -2)))
    (send u RoundInt_down (dec 2.00) (expect (answer 2)))
    (send u RoundInt_down (dec -2.00) (expect (answer -2)))
    (send u RoundInt_down (dec 0.00) (expect (answer 0)))
    (send u RoundInt_down (dec 0.50) (expect (answer 0)))
    (send u RoundInt_down (dec -0.50) (expect (answer 0)))
    (send u RoundInt_down (dec 0.49) (expect (answer 0)))
    (send u RoundInt_down (dec -0.49) (expect (answer 0)))
    (send u RoundInt_down (dec 9223372036854775807.00) (expect (answer 9223372036854775807)))
    (send u RoundInt_down (dec 9223372036854775807.50) (expect (answer 9223372036854775807)))
    (send u RoundInt_down (dec 9223372036854775808.00) (expect (fault overflow)))
    (send u RoundInt_down (dec -9223372036854775808.00) (expect (answer -9223372036854775808)))
    (send u RoundInt_down (dec -9223372036854775808.50) (expect (answer -9223372036854775808)))
    (send u RoundInt_down (dec -9223372036854775809.00) (expect (fault overflow)))
    (send u RoundInt_down (dec 999999999999999999999999999999999999.99) (expect (fault overflow)))
    (send u RoundInt_down (dec -999999999999999999999999999999999999.99) (expect (fault overflow))))
  (example div_down (machine DecimalCalc) (key 1)
    (actor u)
    (send u Div_down (dec 7.50) (dec 2.50) (expect (answer (dec 3.00))))
    (send u Div_down (dec 1.00) (dec 8.00) (expect (answer (dec 0.12))))
    (send u Div_down (dec 3.00) (dec 8.00) (expect (answer (dec 0.37))))
    (send u Div_down (dec -1.00) (dec 8.00) (expect (answer (dec -0.12))))
    (send u Div_down (dec 1.00) (dec -8.00) (expect (answer (dec -0.12))))
    (send u Div_down (dec -3.00) (dec -8.00) (expect (answer (dec 0.37))))
    (send u Div_down (dec 1.00) (dec 3.00) (expect (answer (dec 0.33))))
    (send u Div_down (dec 2.00) (dec 3.00) (expect (answer (dec 0.66))))
    (send u Div_down (dec -1.00) (dec 3.00) (expect (answer (dec -0.33))))
    (send u Div_down (dec 2.00) (dec -3.00) (expect (answer (dec -0.66))))
    (send u Div_down (dec 0.01) (dec 3.00) (expect (answer (dec 0.00))))
    (send u Div_down (dec -0.01) (dec 3.00) (expect (answer (dec 0.00))))
    (send u Div_down (dec 0.00) (dec 5.00) (expect (answer (dec 0.00))))
    (send u Div_down (dec 1.00) (dec 0.00) (expect (fault div_zero)))
    (send u Div_down (dec 0.00) (dec 0.00) (expect (fault div_zero)))
    (send u Div_down (dec 999999999999999999999999999999999999.99) (dec 1.00) (expect (answer (dec 999999999999999999999999999999999999.99))))
    (send u Div_down (dec 999999999999999999999999999999999999.99) (dec 0.01) (expect (fault overflow)))
    (send u Div_down (dec 999999999999999999999999999999999999.99) (dec 0.07) (expect (fault overflow)))
    (send u Div_down (dec -999999999999999999999999999999999999.99) (dec 0.07) (expect (fault overflow)))
    (send u Div_down (dec 0.01) (dec 999999999999999999999999999999999999.99) (expect (answer (dec 0.00))))
    (send u Div_down (dec -0.01) (dec 999999999999999999999999999999999999.99) (expect (answer (dec 0.00)))))
  (example round_ceiling (machine DecimalCalc) (key 1)
    (actor u)
    (send u Round_ceiling (dec 1.250) (expect (answer (dec 1.3))))
    (send u Round_ceiling (dec 1.350) (expect (answer (dec 1.4))))
    (send u Round_ceiling (dec -1.250) (expect (answer (dec -1.2))))
    (send u Round_ceiling (dec -1.350) (expect (answer (dec -1.3))))
    (send u Round_ceiling (dec 1.251) (expect (answer (dec 1.3))))
    (send u Round_ceiling (dec -1.251) (expect (answer (dec -1.2))))
    (send u Round_ceiling (dec 1.249) (expect (answer (dec 1.3))))
    (send u Round_ceiling (dec -1.249) (expect (answer (dec -1.2))))
    (send u Round_ceiling (dec 1.200) (expect (answer (dec 1.2))))
    (send u Round_ceiling (dec -1.200) (expect (answer (dec -1.2))))
