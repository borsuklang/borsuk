(program
  (newtype Cents Int)
  (record Pair (left Int) (right Text))
  (record Names (first Text) (last Text))
  (record Outer (inner Pair) (flag Bool) (tag (Option Int)))
  (record Grown (id Int) (name Text (init "anon")) (score Int (init 7)))
  (enum Shape (Dot) (Circle Int) (Label Text))
  (enum Coin (Heads) (Tails Int))
  (record Mixed (shape Shape) (note Text))
  (record Tail (a Int) (b Unit))
  (protocol PingApi
    (query Ping () Unit))
  (machine Pinger (key Int) (protocol PingApi) (uses) (init Idle)
    (state Idle)
    (in Idle
      (on Ping (block (answer (unit))))))
  (decode unit_value Unit "0100" (value (unit)))
  (decode bool_false Bool "010000" (value false))
  (decode bool_true Bool "010001" (value true))
  (decode int_zero Int "01000000000000000000" (value 0))
  (decode int_minus_one Int "0100ffffffffffffffff" (value -1))
  (decode int_min Int "01000000000000000080" (value -9223372036854775808))
  (decode int_max Int "0100ffffffffffffff7f" (value 9223372036854775807))
  (decode time_zero Time "01000000000000000000" (value (time 0)))
  (decode time_min Time "01000000000000000080" (value (time -9223372036854775808)))
  (decode time_max Time "0100ffffffffffffff7f" (value (time 9223372036854775807)))
  (decode dur_min Duration "01000000000000000080" (value (dur -9223372036854775808)))
  (decode dur_max Duration "0100ffffffffffffff7f" (value (dur 9223372036854775807)))
  (decode text_empty Text "0100" (value ""))
  (decode text_multibyte Text "01007a61c5bcc3b3c582c487" (value "zażółć"))
  (decode text_four_byte Text "0100f09f9880" (value "😀"))
  (decode principal_ann Principal "0100616e6e" (value (principal "ann")))
  (decode f64_neg_zero F64 "01000000000000000080" (value (f64 -0)))
  (decode f64_nan F64 "0100000000000000f87f" (value (f64 nan)))
  (decode f64_inf F64 "0100000000000000f07f" (value (f64 inf)))
  (decode f64_neg_inf F64 "0100000000000000f0ff" (value (f64 -inf)))
  (decode f64_subnormal F64 "01000100000000000000" (value (f64 5e-324)))
  (decode f64_max F64 "0100ffffffffffffef7f" (value (f64 1.7976931348623157e+308)))
  (decode f32_neg_zero F32 "010000000080" (value (f32 -0)))
  (decode f32_nan F32 "01000000c07f" (value (f32 nan)))
  (decode f32_inf F32 "01000000807f" (value (f32 inf)))
  (decode f32_neg_inf F32 "0100000080ff" (value (f32 -inf)))
  (decode f32_subnormal F32 "010001000000" (value (f32 1e-45)))
  (decode f32_max F32 "0100ffff7f7f" (value (f32 3.4028235e+38)))
  (decode dec_zero (Decimal 2) "010000000000000000000000000000000000" (value (dec 0.00)))
  (decode dec_max (Decimal 2) "0100ffffffff3f228a097ac4865aa84c3b4b"
    (value (dec 999999999999999999999999999999999999.99)))
  (decode dec_min (Decimal 2) "010001000000c0dd75f6853b79a557b3c4b4"
    (value (dec -999999999999999999999999999999999999.99)))
  (decode dec0_max (Decimal 0) "0100ffffffff3f228a097ac4865aa84c3b4b"
    (value (dec 99999999999999999999999999999999999999)))
  (decode step_id StepId "01000600000050696e676572070000000000000001000000000000000200000000000000"
    (value (step Pinger 7 1 2)))
  (decode ticket_id Ticket "01000600000050696e6765720700000000000000010000000000000002000000000000000000000000000000"
    (value (ticket Pinger 7 1 2 0)))
  (decode option_none (Option Int) "0100000000000000000000" (value (none)))
  (decode option_some (Option Int) "0100010500000000000000" (value (some 5)))
  (decode option_text (Option Text) "010001050000006869" (value (some "hi")))
  (decode result_ok (Result Int Text) "0100000300000000000000" (value (ok 3)))
  (decode result_err (Result Int Text) "010001050000006e6f" (value (err "no")))
  (decode newtype_cents Cents "0100fa00000000000000" (value (new Cents 250)))
  (decode pair Pair "0100020001000000000000000e00000061" (value (new Pair 1 "a")))
  (decode names Names "010002000a0000000d0000006164616c6f76656c616365"
    (value (new Names "ada" "lovelace")))
  (decode outer Outer "010003001000000001010500000000000000020001000000000000000e00000061"
    (value (new Outer (new Pair 1 "a") true (some 5))))
  (decode grown_full Grown "010003000500000000000000160000000900000000000000626f62"
    (value (new Grown 5 "bob" 9)))
  (decode grown_old Grown "010001000500000000000000" (value (new Grown 5 "anon" 7)))
  (decode shape_dot Shape "010000" (value (new Dot)))
  (decode shape_circle Shape "0100010300000000000000" (value (new Circle 3)))
  (decode shape_label Shape "0100020500000078" (value (new Label "x")))
  (decode coin_heads Coin "0100000000000000000000" (value (new Heads)))
  (decode coin_tails Coin "0100010900000000000000" (value (new Tails 9)))
  (decode mixed Mixed "010002000a000000130000000103000000000000006e"
    (value (new Mixed (new Circle 3) "n")))
  (decode tail Tail "010002000100000000000000" (value (new Tail 1 (unit))))
  (decode bad_version Int "02000000000000000000" (invalid))
  (decode short_frame Int "010000000000000000" (invalid))
  (decode trailing_byte Int "0100000000000000000000" (invalid))
  (decode bool_byte Bool "010002" (invalid))
  (decode option_tag (Option Int) "0100020500000000000000" (invalid))
  (decode result_tag (Result Int Text) "0100020300000000000000" (invalid))
  (decode enum_tag Shape "010003" (invalid))
  (decode nan_f64 F64 "0100010000000000f87f" (invalid))
  (decode nan_f32 F32 "01000100c07f" (invalid))
  (decode decimal_range (Decimal 2) "01000000000040228a097ac4865aa84c3b4b" (invalid))
  (decode text_utf8 Text "01007a61ffbcc3b3c582c487" (invalid))
  (decode machine_name StepId "01000600000050696e676573070000000000000001000000000000000200000000000000"
    (invalid))
  (decode count_above Pair "0100030001000000000000000e00000061" (invalid))
  (decode count_missing Tail "010001000100000000000000" (invalid))
  (decode first_offset Pair "0100020001000000000000000f00000061" (invalid))
  (decode offset_order Names "010002000a000000090000006164616c6f76656c616365" (invalid))
  (decode offset_end Names "010002000a000000160000006164616c6f76656c616365" (invalid))
  (decode padding_byte Coin "0100000000000000000001" (invalid))
  (decode part_bytes Mixed "010002000a000000130000000003000000000000006e" (invalid)))
