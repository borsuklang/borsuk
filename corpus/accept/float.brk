  (example fma_f32 (machine FloatCalc) (key 1)
    (actor u)
    (send u Fma_f32 (f32 2) (f32 3) (f32 4) (expect (answer (f32 10))))
    (send u Fma_f32 (f32 inf) (f32 0) (f32 1) (expect (answer (f32 nan))))
    (send u Fma_f32 (f32 0) (f32 inf) (f32 1) (expect (answer (f32 nan))))
    (send u Fma_f32 (f32 inf) (f32 0) (f32 nan) (expect (answer (f32 nan))))
    (send u Fma_f32 (f32 inf) (f32 1) (f32 -inf) (expect (answer (f32 nan))))
    (send u Fma_f32 (f32 -inf) (f32 1) (f32 inf) (expect (answer (f32 nan))))
    (send u Fma_f32 (f32 inf) (f32 -1) (f32 inf) (expect (answer (f32 nan))))
    (send u Fma_f32 (f32 inf) (f32 1) (f32 inf) (expect (answer (f32 inf))))
    (send u Fma_f32 (f32 inf) (f32 2) (f32 1) (expect (answer (f32 inf))))
    (send u Fma_f32 (f32 1) (f32 1) (f32 -inf) (expect (answer (f32 -inf))))
    (send u Fma_f32 (f32 nan) (f32 1) (f32 1) (expect (answer (f32 nan))))
    (send u Fma_f32 (f32 1) (f32 nan) (f32 1) (expect (answer (f32 nan))))
