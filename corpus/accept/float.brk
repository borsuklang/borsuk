    (send u Fma_f64 (f64 1.0000000000000002) (f64 1) (f64 1.1102230246251565e-16) (expect (answer (f64 1.0000000000000004))))
    (send u Fma_f64 (f64 1.0000000000000002) (f64 1.1102230246251565e-16) (f64 1) (expect (answer (f64 1.0000000000000002))))
