  (example div_f32 (machine FloatCalc) (key 1)
    (actor u)
    (send u Div_f32 (f32 3) (f32 2) (expect (answer (f32 1.5))))
    (send u Div_f32 (f32 1) (f32 3) (expect (answer (f32 0.33333334))))
    (send u Div_f32 (f32 -1) (f32 3) (expect (answer (f32 -0.33333334))))
    (send u Div_f32 (f32 1) (f32 0) (expect (answer (f32 inf))))
    (send u Div_f32 (f32 1) (f32 -0) (expect (answer (f32 -inf))))
    (send u Div_f32 (f32 -1) (f32 0) (expect (answer (f32 -inf))))
    (send u Div_f32 (f32 -1) (f32 -0) (expect (answer (f32 inf))))
    (send u Div_f32 (f32 0) (f32 0) (expect (answer (f32 nan))))
    (send u Div_f32 (f32 -0) (f32 0) (expect (answer (f32 nan))))
    (send u Div_f32 (f32 inf) (f32 inf) (expect (answer (f32 nan))))
    (send u Div_f32 (f32 -inf) (f32 inf) (expect (answer (f32 nan))))
    (send u Div_f32 (f32 nan) (f32 1) (expect (answer (f32 nan))))
    (send u Div_f32 (f32 1) (f32 nan) (expect (answer (f32 nan))))
    (send u Div_f32 (f32 nan) (f32 0) (expect (answer (f32 nan))))
    (send u Div_f32 (f32 0) (f32 1) (expect (answer (f32 0))))
    (send u Div_f32 (f32 -0) (f32 1) (expect (answer (f32 -0))))
    (send u Div_f32 (f32 0) (f32 -1) (expect (answer (f32 -0))))
    (send u Div_f32 (f32 1) (f32 inf) (expect (answer (f32 0))))
    (send u Div_f32 (f32 -1) (f32 inf) (expect (answer (f32 -0))))
    (send u Div_f32 (f32 1) (f32 -inf) (expect (answer (f32 -0))))
    (send u Div_f32 (f32 inf) (f32 2) (expect (answer (f32 inf))))
    (send u Div_f32 (f32 inf) (f32 -0) (expect (answer (f32 -inf))))
    (send u Div_f32 (f32 1.1754944e-38) (f32 2) (expect (answer (f32 5.877472e-39))))
    (send u Div_f32 (f32 1e-45) (f32 2) (expect (answer (f32 0))))
    (send u Div_f32 (f32 1e-45) (f32 1.5) (expect (answer (f32 1e-45))))
    (send u Div_f32 (f32 4e-45) (f32 2) (expect (answer (f32 3e-45))))
    (send u Div_f32 (f32 1e-45) (f32 -2) (expect (answer (f32 -0))))
    (send u Div_f32 (f32 1.1754944e-38) (f32 1.0000001) (expect (answer (f32 1.1754942e-38))))
    (send u Div_f32 (f32 1.1754944e-38) (f32 3.4028235e+38) (expect (answer (f32 0))))
    (send u Div_f32 (f32 -1e-45) (f32 3.4028235e+38) (expect (answer (f32 -0))))
    (send u Div_f32 (f32 3.4028235e+38) (f32 0.5) (expect (answer (f32 inf))))
    (send u Div_f32 (f32 3.4028235e+38) (f32 0.99999994) (expect (answer (f32 inf))))
    (send u Div_f32 (f32 3.4028233e+38) (f32 0.99999994) (expect (answer (f32 3.4028235e+38))))
    (send u Div_f32 (f32 -3.4028233e+38) (f32 0.99999994) (expect (answer (f32 -3.4028235e+38))))
