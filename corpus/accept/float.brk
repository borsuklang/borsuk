  (example fma_f64 (machine FloatCalc) (key 1)
    (actor u)
    (send u Fma_f64 (f64 2) (f64 3) (f64 4) (expect (answer (f64 10))))
    (send u Fma_f64 (f64 inf) (f64 0) (f64 1) (expect (answer (f64 nan))))
    (send u Fma_f64 (f64 0) (f64 inf) (f64 1) (expect (answer (f64 nan))))
    (send u Fma_f64 (f64 inf) (f64 0) (f64 nan) (expect (answer (f64 nan))))
    (send u Fma_f64 (f64 inf) (f64 1) (f64 -inf) (expect (answer (f64 nan))))
    (send u Fma_f64 (f64 -inf) (f64 1) (f64 inf) (expect (answer (f64 nan))))
    (send u Fma_f64 (f64 inf) (f64 -1) (f64 inf) (expect (answer (f64 nan))))
    (send u Fma_f64 (f64 inf) (f64 1) (f64 inf) (expect (answer (f64 inf))))
    (send u Fma_f64 (f64 inf) (f64 2) (f64 1) (expect (answer (f64 inf))))
    (send u Fma_f64 (f64 1) (f64 1) (f64 -inf) (expect (answer (f64 -inf))))
    (send u Fma_f64 (f64 nan) (f64 1) (f64 1) (expect (answer (f64 nan))))
    (send u Fma_f64 (f64 1) (f64 nan) (f64 1) (expect (answer (f64 nan))))
    (send u Fma_f64 (f64 1) (f64 1) (f64 nan) (expect (answer (f64 nan))))
    (send u Fma_f64 (f64 0) (f64 0) (f64 0) (expect (answer (f64 0))))
    (send u Fma_f64 (f64 0) (f64 0) (f64 -0) (expect (answer (f64 0))))
    (send u Fma_f64 (f64 -0) (f64 0) (f64 -0) (expect (answer (f64 -0))))
    (send u Fma_f64 (f64 0) (f64 -1) (f64 0) (expect (answer (f64 0))))
    (send u Fma_f64 (f64 0) (f64 -1) (f64 -0) (expect (answer (f64 -0))))
    (send u Fma_f64 (f64 1) (f64 -1) (f64 1) (expect (answer (f64 0))))
    (send u Fma_f64 (f64 -1) (f64 -1) (f64 -1) (expect (answer (f64 0))))
    (send u Fma_f64 (f64 5e-324) (f64 5e-324) (f64 -0) (expect (answer (f64 0))))
    (send u Fma_f64 (f64 5e-324) (f64 -5e-324) (f64 0) (expect (answer (f64 -0))))
    (send u Fma_f64 (f64 5e-324) (f64 -5e-324) (f64 -0) (expect (answer (f64 -0))))
