  (example meter (machine Meter) (key 1)
    (actor u)
    (send u Set (f64 0.1) (expect (outcome (unit)) (state Holding (f64 0.1))))
    (send u Set (f64 -0) (expect (outcome (unit)) (state Holding (f64 -0))))
    (send u Set (f64 nan) (expect (outcome (unit)) (state Holding (f64 nan))))))
