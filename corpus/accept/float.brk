  (example mul_f32 (machine FloatCalc) (key 1)
    (actor u)
    (send u Mul_f32 (f32 1.5) (f32 2) (expect (answer (f32 3))))
    (send u Mul_f32 (f32 -1.5) (f32 2) (expect (answer (f32 -3))))
    (send u Mul_f32 (f32 0.1) (f32 3) (expect (answer (f32 0.3))))
    (send u Mul_f32 (f32 0) (f32 inf) (expect (answer (f32 nan))))
    (send u Mul_f32 (f32 inf) (f32 0) (expect (answer (f32 nan))))
    (send u Mul_f32 (f32 -0) (f32 inf) (expect (answer (f32 nan))))
    (send u Mul_f32 (f32 -inf) (f32 -0) (expect (answer (f32 nan))))
    (send u Mul_f32 (f32 inf) (f32 inf) (expect (answer (f32 inf))))
    (send u Mul_f32 (f32 inf) (f32 -inf) (expect (answer (f32 -inf))))
    (send u Mul_f32 (f32 -inf) (f32 -2) (expect (answer (f32 inf))))
    (send u Mul_f32 (f32 nan) (f32 1) (expect (answer (f32 nan))))
    (send u Mul_f32 (f32 1) (f32 nan) (expect (answer (f32 nan))))
    (send u Mul_f32 (f32 nan) (f32 0) (expect (answer (f32 nan))))
    (send u Mul_f32 (f32 0) (f32 0) (expect (answer (f32 0))))
    (send u Mul_f32 (f32 -0) (f32 0) (expect (answer (f32 -0))))
    (send u Mul_f32 (f32 0) (f32 -0) (expect (answer (f32 -0))))
