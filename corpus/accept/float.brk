  (example eq_f32 (machine FloatCalc) (key 1)
    (actor u)
    (send u Eq_f32 (f32 -inf) (f32 -inf) (expect (answer true)))
    (send u Eq_f32 (f32 -inf) (f32 -1) (expect (answer false)))
