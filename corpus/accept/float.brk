  (example div_f64 (machine FloatCalc) (key 1)
    (actor u)
    (send u Div_f64 (f64 3) (f64 2) (expect (answer (f64 1.5))))
    (send u Div_f64 (f64 1) (f64 3) (expect (answer (f64 0.3333333333333333))))
    (send u Div_f64 (f64 -1) (f64 3) (expect (answer (f64 -0.3333333333333333))))
    (send u Div_f64 (f64 1) (f64 0) (expect (answer (f64 inf))))
    (send u Div_f64 (f64 1) (f64 -0) (expect (answer (f64 -inf))))
    (send u Div_f64 (f64 -1) (f64 0) (expect (answer (f64 -inf))))
    (send u Div_f64 (f64 -1) (f64 -0) (expect (answer (f64 inf))))
    (send u Div_f64 (f64 0) (f64 0) (expect (answer (f64 nan))))
    (send u Div_f64 (f64 -0) (f64 0) (expect (answer (f64 nan))))
    (send u Div_f64 (f64 inf) (f64 inf) (expect (answer (f64 nan))))
    (send u Div_f64 (f64 -inf) (f64 inf) (expect (answer (f64 nan))))
    (send u Div_f64 (f64 nan) (f64 1) (expect (answer (f64 nan))))
    (send u Div_f64 (f64 1) (f64 nan) (expect (answer (f64 nan))))
    (send u Div_f64 (f64 nan) (f64 0) (expect (answer (f64 nan))))
    (send u Div_f64 (f64 0) (f64 1) (expect (answer (f64 0))))
    (send u Div_f64 (f64 -0) (f64 1) (expect (answer (f64 -0))))
    (send u Div_f64 (f64 0) (f64 -1) (expect (answer (f64 -0))))
    (send u Div_f64 (f64 1) (f64 inf) (expect (answer (f64 0))))
    (send u Div_f64 (f64 -1) (f64 inf) (expect (answer (f64 -0))))
    (send u Div_f64 (f64 1) (f64 -inf) (expect (answer (f64 -0))))
    (send u Div_f64 (f64 inf) (f64 2) (expect (answer (f64 inf))))
    (send u Div_f64 (f64 inf) (f64 -0) (expect (answer (f64 -inf))))
    (send u Div_f64 (f64 2.2250738585072014e-308) (f64 2) (expect (answer (f64 1.1125369292536007e-308))))
    (send u Div_f64 (f64 5e-324) (f64 2) (expect (answer (f64 0))))
    (send u Div_f64 (f64 5e-324) (f64 1.5) (expect (answer (f64 5e-324))))
    (send u Div_f64 (f64 1.5e-323) (f64 2) (expect (answer (f64 1e-323))))
