    (send u Sub_f64 (f64 1.7976931348623157e+308) (f64 -9.9792015476736e+291) (expect (answer (f64 inf))))
    (send u Sub_f64 (f64 1) (f64 5.551115123125783e-17) (expect (answer (f64 1))))
