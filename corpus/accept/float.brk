  (example lit_f32 (machine FloatCalc) (key 1)
    (actor u)
    (send u Lit_f32 (expect (answer (f32 0.1)))))
  (example add_f32 (machine FloatCalc) (key 1)
    (actor u)
    (send u Add_f32 (f32 1) (f32 2) (expect (answer (f32 3))))
    (send u Add_f32 (f32 0.1) (f32 0.2) (expect (answer (f32 0.3))))
    (send u Add_f32 (f32 inf) (f32 1) (expect (answer (f32 inf))))
