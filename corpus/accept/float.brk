  (example sub_f64 (machine FloatCalc) (key 1)
    (actor u)
    (send u Sub_f64 (f64 3) (f64 1) (expect (answer (f64 2))))
    (send u Sub_f64 (f64 1) (f64 3) (expect (answer (f64 -2))))
    (send u Sub_f64 (f64 0.3) (f64 0.1) (expect (answer (f64 0.19999999999999998))))
    (send u Sub_f64 (f64 inf) (f64 inf) (expect (answer (f64 nan))))
    (send u Sub_f64 (f64 -inf) (f64 -inf) (expect (answer (f64 nan))))
    (send u Sub_f64 (f64 inf) (f64 -inf) (expect (answer (f64 inf))))
    (send u Sub_f64 (f64 -inf) (f64 inf) (expect (answer (f64 -inf))))
    (send u Sub_f64 (f64 1) (f64 inf) (expect (answer (f64 -inf))))
    (send u Sub_f64 (f64 nan) (f64 1) (expect (answer (f64 nan))))
    (send u Sub_f64 (f64 1) (f64 nan) (expect (answer (f64 nan))))
    (send u Sub_f64 (f64 0) (f64 0) (expect (answer (f64 0))))
    (send u Sub_f64 (f64 0) (f64 -0) (expect (answer (f64 0))))
    (send u Sub_f64 (f64 -0) (f64 0) (expect (answer (f64 -0))))
    (send u Sub_f64 (f64 -0) (f64 -0) (expect (answer (f64 0))))
    (send u Sub_f64 (f64 1.5) (f64 1.5) (expect (answer (f64 0))))
    (send u Sub_f64 (f64 -1.5) (f64 -1.5) (expect (answer (f64 0))))
    (send u Sub_f64 (f64 2.2250738585072014e-308) (f64 5e-324) (expect (answer (f64 2.225073858507201e-308))))
    (send u Sub_f64 (f64 2.225073858507201e-308) (f64 -5e-324) (expect (answer (f64 2.2250738585072014e-308))))
    (send u Sub_f64 (f64 1e-323) (f64 5e-324) (expect (answer (f64 5e-324))))
    (send u Sub_f64 (f64 5e-324) (f64 5e-324) (expect (answer (f64 0))))
    (send u Sub_f64 (f64 -5e-324) (f64 5e-324) (expect (answer (f64 -1e-323))))
    (send u Sub_f64 (f64 1.7976931348623157e+308) (f64 -1.7976931348623157e+308) (expect (answer (f64 inf))))
    (send u Sub_f64 (f64 -1.7976931348623157e+308) (f64 1.7976931348623157e+308) (expect (answer (f64 -inf))))
