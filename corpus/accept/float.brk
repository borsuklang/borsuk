  (example mul_f64 (machine FloatCalc) (key 1)
    (actor u)
    (send u Mul_f64 (f64 1.5) (f64 2) (expect (answer (f64 3))))
    (send u Mul_f64 (f64 -1.5) (f64 2) (expect (answer (f64 -3))))
    (send u Mul_f64 (f64 0.1) (f64 3) (expect (answer (f64 0.30000000000000004))))
    (send u Mul_f64 (f64 0) (f64 inf) (expect (answer (f64 nan))))
    (send u Mul_f64 (f64 inf) (f64 0) (expect (answer (f64 nan))))
    (send u Mul_f64 (f64 -0) (f64 inf) (expect (answer (f64 nan))))
    (send u Mul_f64 (f64 -inf) (f64 -0) (expect (answer (f64 nan))))
    (send u Mul_f64 (f64 inf) (f64 inf) (expect (answer (f64 inf))))
    (send u Mul_f64 (f64 inf) (f64 -inf) (expect (answer (f64 -inf))))
    (send u Mul_f64 (f64 -inf) (f64 -2) (expect (answer (f64 inf))))
    (send u Mul_f64 (f64 nan) (f64 1) (expect (answer (f64 nan))))
    (send u Mul_f64 (f64 1) (f64 nan) (expect (answer (f64 nan))))
    (send u Mul_f64 (f64 nan) (f64 0) (expect (answer (f64 nan))))
    (send u Mul_f64 (f64 0) (f64 0) (expect (answer (f64 0))))
    (send u Mul_f64 (f64 -0) (f64 0) (expect (answer (f64 -0))))
    (send u Mul_f64 (f64 0) (f64 -0) (expect (answer (f64 -0))))
    (send u Mul_f64 (f64 -0) (f64 -0) (expect (answer (f64 0))))
