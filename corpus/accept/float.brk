(program
  (protocol FloatOps
    (query Lit_f64 () F64)
    (query Add_f64 ((a F64) (b F64)) F64)
    (query Sub_f64 ((a F64) (b F64)) F64)
    (query Mul_f64 ((a F64) (b F64)) F64)
    (query Div_f64 ((a F64) (b F64)) F64)
    (query Sqrt_f64 ((a F64)) F64)
    (query Fma_f64 ((a F64) (b F64) (c F64)) F64)
    (query Eq_f64 ((a F64) (b F64)) Bool)
    (query Lt_f64 ((a F64) (b F64)) Bool)
    (query Lit_f32 () F32)
    (query Add_f32 ((a F32) (b F32)) F32)
    (query Sub_f32 ((a F32) (b F32)) F32)
    (query Mul_f32 ((a F32) (b F32)) F32)
    (query Div_f32 ((a F32) (b F32)) F32)
    (query Sqrt_f32 ((a F32)) F32)
    (query Fma_f32 ((a F32) (b F32) (c F32)) F32)
    (query Eq_f32 ((a F32) (b F32)) Bool)
    (query Lt_f32 ((a F32) (b F32)) Bool))
  (machine FloatCalc (key Int) (protocol FloatOps) (uses) (init Ready)
    (state Ready)
    (in Ready
      (on Lit_f64 (block (answer (f64 0.1))))
      (on Add_f64 (block (answer (+ a b))))
      (on Sub_f64 (block (answer (- a b))))
      (on Mul_f64 (block (answer (* a b))))
      (on Div_f64 (block (answer (/ a b))))
      (on Sqrt_f64 (block (answer (sqrt a))))
      (on Fma_f64 (block (answer (fma a b c))))
      (on Eq_f64 (block (answer (== a b))))
      (on Lt_f64 (block (answer (< a b))))
      (on Lit_f32 (block (answer (f32 0.1))))
      (on Add_f32 (block (answer (+ a b))))
      (on Sub_f32 (block (answer (- a b))))
      (on Mul_f32 (block (answer (* a b))))
      (on Div_f32 (block (answer (/ a b))))
      (on Sqrt_f32 (block (answer (sqrt a))))
      (on Fma_f32 (block (answer (fma a b c))))
      (on Eq_f32 (block (answer (== a b))))
      (on Lt_f32 (block (answer (< a b))))))
  (protocol MeterOps
    (command Set ((v F64)) Unit (rejects)))
  (machine Meter (key Int) (protocol MeterOps) (uses) (init Empty)
    (state Empty)
    (state Holding (v F64))
    (group Any Empty Holding)
    (in Any
      (on Set (block (next (Holding v) (outcome (unit)))))))
  (example lit_f64 (machine FloatCalc) (key 1)
    (actor u)
    (send u Lit_f64 (expect (answer (f64 0.1)))))
  (example add_f64 (machine FloatCalc) (key 1)
    (actor u)
    (send u Add_f64 (f64 1) (f64 2) (expect (answer (f64 3))))
    (send u Add_f64 (f64 0.1) (f64 0.2) (expect (answer (f64 0.30000000000000004))))
    (send u Add_f64 (f64 inf) (f64 1) (expect (answer (f64 inf))))
    (send u Add_f64 (f64 -1) (f64 -inf) (expect (answer (f64 -inf))))
    (send u Add_f64 (f64 inf) (f64 inf) (expect (answer (f64 inf))))
    (send u Add_f64 (f64 inf) (f64 -inf) (expect (answer (f64 nan))))
    (send u Add_f64 (f64 -inf) (f64 inf) (expect (answer (f64 nan))))
    (send u Add_f64 (f64 nan) (f64 1) (expect (answer (f64 nan))))
    (send u Add_f64 (f64 1) (f64 nan) (expect (answer (f64 nan))))
    (send u Add_f64 (f64 nan) (f64 inf) (expect (answer (f64 nan))))
    (send u Add_f64 (f64 0) (f64 0) (expect (answer (f64 0))))
    (send u Add_f64 (f64 0) (f64 -0) (expect (answer (f64 0))))
    (send u Add_f64 (f64 -0) (f64 0) (expect (answer (f64 0))))
    (send u Add_f64 (f64 -0) (f64 -0) (expect (answer (f64 -0))))
    (send u Add_f64 (f64 1.5) (f64 -1.5) (expect (answer (f64 0))))
    (send u Add_f64 (f64 -1.5) (f64 1.5) (expect (answer (f64 0))))
    (send u Add_f64 (f64 5e-324) (f64 5e-324) (expect (answer (f64 1e-323))))
    (send u Add_f64 (f64 2.225073858507201e-308) (f64 5e-324) (expect (answer (f64 2.2250738585072014e-308))))
    (send u Add_f64 (f64 2.2250738585072014e-308) (f64 -5e-324) (expect (answer (f64 2.225073858507201e-308))))
    (send u Add_f64 (f64 5e-324) (f64 -5e-324) (expect (answer (f64 0))))
    (send u Add_f64 (f64 -5e-324) (f64 -5e-324) (expect (answer (f64 -1e-323))))
    (send u Add_f64 (f64 1.7976931348623157e+308) (f64 1.7976931348623157e+308) (expect (answer (f64 inf))))
    (send u Add_f64 (f64 -1.7976931348623157e+308) (f64 -1.7976931348623157e+308) (expect (answer (f64 -inf))))
    (send u Add_f64 (f64 1.7976931348623157e+308) (f64 9.9792015476736e+291) (expect (answer (f64 inf))))
