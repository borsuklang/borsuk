(program
  (protocol MathOps
    (query Exp_f64 ((x F64)) F64)
    (query Exp_f32 ((x F32)) F32)
    (query Exp2_f64 ((x F64)) F64)
    (query Exp2_f32 ((x F32)) F32)
    (query Log_f64 ((x F64)) F64)
    (query Log_f32 ((x F32)) F32)
    (query Log2_f64 ((x F64)) F64)
    (query Log2_f32 ((x F32)) F32)
    (query Log10_f64 ((x F64)) F64)
    (query Log10_f32 ((x F32)) F32)
    (query Sin_f64 ((x F64)) F64)
    (query Sin_f32 ((x F32)) F32)
    (query Cos_f64 ((x F64)) F64)
    (query Cos_f32 ((x F32)) F32)
    (query Tan_f64 ((x F64)) F64)
    (query Tan_f32 ((x F32)) F32)
    (query Asin_f64 ((x F64)) F64)
    (query Asin_f32 ((x F32)) F32)
    (query Acos_f64 ((x F64)) F64)
    (query Acos_f32 ((x F32)) F32)
    (query Atan_f64 ((x F64)) F64)
    (query Atan_f32 ((x F32)) F32)
    (query Sinh_f64 ((x F64)) F64)
    (query Sinh_f32 ((x F32)) F32)
    (query Cosh_f64 ((x F64)) F64)
    (query Cosh_f32 ((x F32)) F32)
    (query Tanh_f64 ((x F64)) F64)
    (query Tanh_f32 ((x F32)) F32)
    (query Cbrt_f64 ((x F64)) F64)
    (query Cbrt_f32 ((x F32)) F32)
    (query Pow_f64 ((x F64) (y F64)) F64)
    (query Pow_f32 ((x F32) (y F32)) F32)
    (query Atan2_f64 ((y F64) (x F64)) F64)
    (query Atan2_f32 ((y F32) (x F32)) F32)
    (query Hypot_f64 ((x F64) (y F64)) F64)
    (query Hypot_f32 ((x F32) (y F32)) F32))
  (machine MathCalc (key Int) (protocol MathOps) (uses) (init Ready)
    (state Ready)
    (in Ready
      (on Exp_f64 (block (answer (exp x))))
      (on Exp_f32 (block (answer (exp x))))
      (on Exp2_f64 (block (answer (exp2 x))))
      (on Exp2_f32 (block (answer (exp2 x))))
      (on Log_f64 (block (answer (log x))))
      (on Log_f32 (block (answer (log x))))
      (on Log2_f64 (block (answer (log2 x))))
      (on Log2_f32 (block (answer (log2 x))))
      (on Log10_f64 (block (answer (log10 x))))
      (on Log10_f32 (block (answer (log10 x))))
      (on Sin_f64 (block (answer (sin x))))
      (on Sin_f32 (block (answer (sin x))))
      (on Cos_f64 (block (answer (cos x))))
      (on Cos_f32 (block (answer (cos x))))
      (on Tan_f64 (block (answer (tan x))))
      (on Tan_f32 (block (answer (tan x))))
      (on Asin_f64 (block (answer (asin x))))
      (on Asin_f32 (block (answer (asin x))))
      (on Acos_f64 (block (answer (acos x))))
      (on Acos_f32 (block (answer (acos x))))
      (on Atan_f64 (block (answer (atan x))))
      (on Atan_f32 (block (answer (atan x))))
      (on Sinh_f64 (block (answer (sinh x))))
      (on Sinh_f32 (block (answer (sinh x))))
      (on Cosh_f64 (block (answer (cosh x))))
      (on Cosh_f32 (block (answer (cosh x))))
      (on Tanh_f64 (block (answer (tanh x))))
      (on Tanh_f32 (block (answer (tanh x))))
      (on Cbrt_f64 (block (answer (cbrt x))))
      (on Cbrt_f32 (block (answer (cbrt x))))
      (on Pow_f64 (block (answer (pow x y))))
      (on Pow_f32 (block (answer (pow x y))))
      (on Atan2_f64 (block (answer (atan2 y x))))
      (on Atan2_f32 (block (answer (atan2 y x))))
      (on Hypot_f64 (block (answer (hypot x y))))
      (on Hypot_f32 (block (answer (hypot x y))))))
  (example exp_f64 (machine MathCalc) (key 1)
    (actor u)
    (send u Exp_f64 (f64 nan) (expect (answer (f64 nan))))
    (send u Exp_f64 (f64 0) (expect (answer (f64 1))))
    (send u Exp_f64 (f64 -0) (expect (answer (f64 1))))
    (send u Exp_f64 (f64 -inf) (expect (answer (f64 0))))
    (send u Exp_f64 (f64 inf) (expect (answer (f64 inf))))
