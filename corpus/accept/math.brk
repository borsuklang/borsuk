  (example sin_f64 (machine MathCalc) (key 1)
    (actor u)
    (send u Sin_f64 (f64 nan) (expect (answer (f64 nan))))
    (send u Sin_f64 (f64 0) (expect (answer (f64 0))))
    (send u Sin_f64 (f64 -0) (expect (answer (f64 -0))))
