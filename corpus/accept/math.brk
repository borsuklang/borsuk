  (example hypot_f32 (machine MathCalc) (key 1)
    (actor u)
    (send u Hypot_f32 (f32 nan) (f32 1) (expect (answer (f32 nan))))
    (send u Hypot_f32 (f32 1) (f32 nan) (expect (answer (f32 nan))))
    (send u Hypot_f32 (f32 inf) (f32 1) (expect (answer (f32 inf))))
    (send u Hypot_f32 (f32 -inf) (f32 1) (expect (answer (f32 inf))))
    (send u Hypot_f32 (f32 1) (f32 inf) (expect (answer (f32 inf))))
    (send u Hypot_f32 (f32 1) (f32 -inf) (expect (answer (f32 inf))))
    (send u Hypot_f32 (f32 inf) (f32 nan) (expect (answer (f32 inf))))
    (send u Hypot_f32 (f32 -inf) (f32 nan) (expect (answer (f32 inf))))
