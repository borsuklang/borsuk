  (example hypot_f64 (machine MathCalc) (key 1)
    (actor u)
    (send u Hypot_f64 (f64 nan) (f64 1) (expect (answer (f64 nan))))
    (send u Hypot_f64 (f64 1) (f64 nan) (expect (answer (f64 nan))))
    (send u Hypot_f64 (f64 inf) (f64 1) (expect (answer (f64 inf))))
    (send u Hypot_f64 (f64 -inf) (f64 1) (expect (answer (f64 inf))))
    (send u Hypot_f64 (f64 1) (f64 inf) (expect (answer (f64 inf))))
    (send u Hypot_f64 (f64 1) (f64 -inf) (expect (answer (f64 inf))))
    (send u Hypot_f64 (f64 inf) (f64 nan) (expect (answer (f64 inf))))
    (send u Hypot_f64 (f64 -inf) (f64 nan) (expect (answer (f64 inf))))
    (send u Hypot_f64 (f64 nan) (f64 inf) (expect (answer (f64 inf))))
    (send u Hypot_f64 (f64 nan) (f64 -inf) (expect (answer (f64 inf))))
    (send u Hypot_f64 (f64 3) (f64 0) (expect (answer (f64 3))))
