  (example atan2_f64 (machine MathCalc) (key 1)
    (actor u)
    (send u Atan2_f64 (f64 nan) (f64 1) (expect (answer (f64 nan))))
    (send u Atan2_f64 (f64 1) (f64 nan) (expect (answer (f64 nan))))
    (send u Atan2_f64 (f64 0) (f64 -0) (expect (answer (f64 3.141592653589793))))
    (send u Atan2_f64 (f64 -0) (f64 -0) (expect (answer (f64 -3.141592653589793))))
    (send u Atan2_f64 (f64 0) (f64 0) (expect (answer (f64 0))))
    (send u Atan2_f64 (f64 -0) (f64 0) (expect (answer (f64 -0))))
    (send u Atan2_f64 (f64 0) (f64 -1) (expect (answer (f64 3.141592653589793))))
    (send u Atan2_f64 (f64 -0) (f64 -1) (expect (answer (f64 -3.141592653589793))))
    (send u Atan2_f64 (f64 0) (f64 -5e-324) (expect (answer (f64 3.141592653589793))))
    (send u Atan2_f64 (f64 -0) (f64 -1.7976931348623157e+308) (expect (answer (f64 -3.141592653589793))))
    (send u Atan2_f64 (f64 0) (f64 -inf) (expect (answer (f64 3.141592653589793))))
    (send u Atan2_f64 (f64 -0) (f64 -inf) (expect (answer (f64 -3.141592653589793))))
    (send u Atan2_f64 (f64 0) (f64 1) (expect (answer (f64 0))))
    (send u Atan2_f64 (f64 -0) (f64 1) (expect (answer (f64 -0))))
    (send u Atan2_f64 (f64 0) (f64 5e-324) (expect (answer (f64 0))))
