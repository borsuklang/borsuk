  (example pow_f32 (machine MathCalc) (key 1)
    (actor u)
    (send u Pow_f32 (f32 nan) (f32 2) (expect (answer (f32 nan))))
    (send u Pow_f32 (f32 2) (f32 nan) (expect (answer (f32 nan))))
    (send u Pow_f32 (f32 1) (f32 3) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 1) (f32 -0.5) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 1) (f32 3.4028235e+38) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 1) (f32 inf) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 1) (f32 -inf) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 1) (f32 nan) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 3) (f32 0) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 -3) (f32 -0) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 0) (f32 0) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 -inf) (f32 -0) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 inf) (f32 0) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 nan) (f32 0) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 nan) (f32 -0) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 0) (f32 -1) (expect (answer (f32 inf))))
    (send u Pow_f32 (f32 -0) (f32 -1) (expect (answer (f32 -inf))))
    (send u Pow_f32 (f32 -0) (f32 -3) (expect (answer (f32 -inf))))
    (send u Pow_f32 (f32 -0) (f32 -16777215) (expect (answer (f32 -inf))))
    (send u Pow_f32 (f32 0) (f32 -2) (expect (answer (f32 inf))))
    (send u Pow_f32 (f32 -0) (f32 -2) (expect (answer (f32 inf))))
    (send u Pow_f32 (f32 -0) (f32 -0.5) (expect (answer (f32 inf))))
    (send u Pow_f32 (f32 -0) (f32 -3.4028235e+38) (expect (answer (f32 inf))))
    (send u Pow_f32 (f32 0) (f32 -inf) (expect (answer (f32 inf))))
    (send u Pow_f32 (f32 -0) (f32 -inf) (expect (answer (f32 inf))))
    (send u Pow_f32 (f32 0) (f32 1) (expect (answer (f32 0))))
    (send u Pow_f32 (f32 -0) (f32 1) (expect (answer (f32 -0))))
    (send u Pow_f32 (f32 -0) (f32 3) (expect (answer (f32 -0))))
    (send u Pow_f32 (f32 -0) (f32 16777215) (expect (answer (f32 -0))))
    (send u Pow_f32 (f32 0) (f32 2) (expect (answer (f32 0))))
    (send u Pow_f32 (f32 -0) (f32 2) (expect (answer (f32 0))))
    (send u Pow_f32 (f32 -0) (f32 0.5) (expect (answer (f32 0))))
    (send u Pow_f32 (f32 -0) (f32 3.4028235e+38) (expect (answer (f32 0))))
    (send u Pow_f32 (f32 0) (f32 inf) (expect (answer (f32 0))))
    (send u Pow_f32 (f32 -0) (f32 inf) (expect (answer (f32 0))))
    (send u Pow_f32 (f32 -1) (f32 inf) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 -1) (f32 -inf) (expect (answer (f32 1))))
    (send u Pow_f32 (f32 -2) (f32 0.5) (expect (answer (f32 nan))))
    (send u Pow_f32 (f32 -0.5) (f32 -2.5) (expect (answer (f32 nan))))
